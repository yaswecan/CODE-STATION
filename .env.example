# PostgreSQL / Neon (obligatoire sur Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secret long et aléatoire pour signer les sessions.
# Exemple: openssl rand -base64 48
SESSION_SECRET=change-me-with-a-long-random-value

# Optionnel
SESSION_TTL_SECONDS=43200
PIN_PBKDF2_ITERATIONS=260000
MAX_PROGRESS_BYTES=2000000
